# ============================================================
# LunaFlow Project .gitignore
# ============================================================

# 敏感日志(包含 NAS 私网 IP 与访问路径)
*.log
.nas_ocr_pipeline.log

# 系统临时文件
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# 编辑器
.vscode/
.idea/
*.iml

# 构建产物(如有)
node_modules/
dist/
build/
*.min.js
*.min.css

# 临时 OCR / 中间产物(可选,若想保留数据请删除此条)
# /tmp/lunaflow_*
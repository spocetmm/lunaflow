# ============================================================
# LunaFlow Project .gitignore
# ============================================================

# 敏感日志(包含 NAS 私网 IP 与访问路径)
*.log
.nas_ocr_pipeline.log

# 系统临时文件
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# 编辑器
.vscode/
.idea/
*.iml

# 构建产物(如有)
node_modules/
dist/
build/
*.min.js
*.min.css

# 临时 OCR / 中间产物(可选,若想保留数据请删除此条)
# /tmp/lunaflow_*

# ============================================================
# nas-ocr-chart-classifier 批量产物
#   docs/分析报告/ 与 docs/生理期选品心理专项/ 下所有内容
#   均为可重新生成的 pipeline 输出
#   (PDF 原件 / *.ocr.json / *.analyzed_summary.json / 封面 webp / 中间 log)
#   不进版本控制,任何时刻可通过 skill 重新抓取
# ============================================================
docs/分析报告/
docs/生理期选品心理专项/